# Required — Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Supabase anon key (only if client-side Supabase Auth is used; not required for current service-role architecture)
SUPABASE_ANON_KEY=

# Required — JWT
JWT_SECRET=
# Optional — JWT expiry (default 8h, max 7d, format: 30m, 8h, 1d)
JWT_EXPIRES_IN=

# App URL
NEXT_PUBLIC_APP_URL=

# Optional — Auto-seed first admin (used by instrumentation.ts when no users exist)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Optional — Upstash Redis for distributed rate limiting (falls back to in-memory if not set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — Vercel (set automatically on Vercel)
VERCEL=
VERCEL_ENV=
